# 인스턴스 A의 ~/roampass/.env 로 복사해 값 입력(서버에만 두고 커밋하지 않음)
IMAGE_OWNER=voyager003
POSTGRES_DB=roampass
POSTGRES_USER=roampass
POSTGRES_PASSWORD=
INSTANCE_B_PRIVATE_IP=
# 아래 두 값은 인스턴스 B의 .env와 반드시 같게. 예: openssl rand -hex 32
PG_WEBHOOK_SECRET=
SUPPLIER_CALLBACK_SECRET=
# 프론트 배포 주소(쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=
